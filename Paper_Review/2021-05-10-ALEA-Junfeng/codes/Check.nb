Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"t_", ",", "x_"}], "]"}], "=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{
     SqrtBox[
      RowBox[{"2", "\[Pi]"}]], "t"}]], 
   RowBox[{"Exp", "[", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}], 
     RowBox[{"2", "t"}]], "]"}]}]}]], "Input",
