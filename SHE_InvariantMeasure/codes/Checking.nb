Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox[
     RowBox[{"Abs", "[", 
      RowBox[{"r", "-", "x"}], "]"}], "\[Alpha]"], " ", 
    RowBox[{"Exp", "[", 
