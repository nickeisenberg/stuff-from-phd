       RowBox[{"1", "+", 
        FractionBox["\[Alpha]", "2"]}], ",", 
       FractionBox["3", "2"], ",", 
       FractionBox[
        SuperscriptBox["r", "2"], "2"]}], "]"}]}]}], ")"}]}]], "Output",
