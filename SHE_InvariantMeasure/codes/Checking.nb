      RowBox[{"s", "/", "2"}]]}]], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", ">", 
       RowBox[{"d", "-", "2"}]}], ",", 
