Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"r", "-", "x"}], "]"}], "\[Alpha]"], " "}], 
        RowBox[{"1", "+", 
         SuperscriptBox["r", "\[Alpha]"]}]], 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["x", "2"]}], "/", "2"}], "]"}]}], "/.", 
      RowBox[{"\[Alpha]", "->", 
       RowBox[{"3", "/", "2"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "6"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}]}], "]"}]], "Input",
