Cell[BoxData[
 RowBox[{
  SuperscriptBox["2", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["3", "2"]}], "-", 
    FractionBox["\[Alpha]", "2"]}]], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["r", "2"], "2"]}]], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{
       FractionBox["3", "2"], "+", "\[Alpha]"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       SuperscriptBox["r", "2"], "2"]], " ", "r", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", 
       FractionBox["\[Alpha]", "2"]}], "]"}], " ", 
     RowBox[{"Hypergeometric1F1", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], "-", 
        FractionBox["\[Alpha]", "2"]}], ",", 
       FractionBox["3", "2"], ",", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["r", "2"], "2"]}]}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"1", "+", "\[Alpha]"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      FractionBox[
       SuperscriptBox["r", "2"], "2"]], " ", 
     RowBox[{"Gamma", "[", 
      FractionBox[
       RowBox[{"1", "+", "\[Alpha]"}], "2"], "]"}], " ", 
     RowBox[{"Hypergeometric1F1", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[Alpha]", "2"]}], ",", 
       FractionBox["1", "2"], ",", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["r", "2"], "2"]}]}], "]"}]}], "+", 
    RowBox[{
     SqrtBox["2"], " ", "r", " ", 
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", "\[Alpha]"}], "]"}], " ", 
     RowBox[{"HypergeometricU", "[", 
      RowBox[{
       RowBox[{"1", "+", 
        FractionBox["\[Alpha]", "2"]}], ",", 
       FractionBox["3", "2"], ",", 
       FractionBox[
        SuperscriptBox["r", "2"], "2"]}], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.860673908152401*^9},
