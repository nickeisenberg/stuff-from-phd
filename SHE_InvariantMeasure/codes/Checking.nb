Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["r", "2"]}], "+", 
       SuperscriptBox["r", "b"]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["r", "2"], "-", 
       RowBox[{"b", " ", 
        SuperscriptBox["r", "b"]}]}], ")"}]}], "r"]}], "+", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "r"], 
   RowBox[{
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       SuperscriptBox["r", "b"], "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"r", "-", "y"}], ")"}], "b"], "-", 
       SuperscriptBox["y", "2"]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "b"}], ")"}], " ", "b", " ", 
        SuperscriptBox["r", 
         RowBox[{
          RowBox[{"-", "2"}], "+", "b"}]]}], "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"b", " ", 
           SuperscriptBox["r", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "b"}]]}], "-", 
          RowBox[{"b", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"r", "-", "y"}], ")"}], 
            RowBox[{
             RowBox[{"-", "1"}], "+", "b"}]]}]}], ")"}], "2"], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "b"}], ")"}], " ", "b", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "-", "y"}], ")"}], 
         RowBox[{
          RowBox[{"-", "2"}], "+", "b"}]]}]}], ")"}]}], 
    RowBox[{"\[DifferentialD]", "y"}]}]}]}]], "Output",
 CellChangeTimes->{3.864594192480582*^9},
