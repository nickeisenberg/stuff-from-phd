Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"2", 
    SqrtBox[
     RowBox[{"1", "-", "x"}]], 
    RowBox[{"Cos", "[", 
     RowBox[{"x", " ", "y"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.86298837501621*^9, 3.862988375346198*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"0d70fd74-bb49-48e6-b9fa-c686e072fff1"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "y"}]], " ", 
    SqrtBox["\[Pi]"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", "y"}]]}], " ", 
       RowBox[{"Erf", "[", 
        SqrtBox[
         RowBox[{"\[ImaginaryI]", " ", "y"}]], "]"}]}], "+", 
      RowBox[{"Erfi", "[", 
       SqrtBox[
        RowBox[{"\[ImaginaryI]", " ", "y"}]], "]"}]}], ")"}]}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[ImaginaryI]", " ", "y"}], ")"}], 
     RowBox[{"3", "/", "2"}]]}]]}]], "Output",
 CellChangeTimes->{3.86298837879657*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"4fede194-487e-4ce1-9c6e-20cf22e33259"]
}, Open  ]],

