Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{"d", "-", "1"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["z", "2"]}], ")"}], 
      RowBox[{
       RowBox[{"-", "s"}], "/", "2"}]], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox["z", "2"]}], 
       RowBox[{"4", "r"}]], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", ">", "0"}], ",", 
       RowBox[{"d", ">=", "1"}], ",", " ", 
       RowBox[{"d", " ", "\[Element]", " ", "Integers"}]}], "}"}]}]}], "]"}], 
  "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.8765672283445187`*^9, 3.8765673571602583`*^9}, {
  3.876567597691949*^9, 3.8765675986894836`*^9}},
