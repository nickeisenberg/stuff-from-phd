Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox[
    FractionBox["\[Pi]", "2"]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "x"}], "]"}]}], " ", 
      RowBox[{"FresnelS", "[", 
       FractionBox[
        RowBox[{"2", " ", 
         SqrtBox["x"]}], 
        SqrtBox["\[Pi]"]], "]"}]}], "+", 
     RowBox[{
      RowBox[{"FresnelC", "[", 
       FractionBox[
        RowBox[{"2", " ", 
         SqrtBox["x"]}], 
        SqrtBox["\[Pi]"]], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "x"}], "]"}]}]}], ")"}]}], 
  SuperscriptBox["x", 
   RowBox[{"3", "/", "2"}]]]], "Output",
