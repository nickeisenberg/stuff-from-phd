 CellLabel->"In[44]:=",ExpressionUUID->"cf5a9489-a576-4661-b8c2-28c9c6545a80"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "x"}], "]"}]}], " ", 
    RowBox[{"FresnelS", "[", 
     FractionBox[
      RowBox[{"2", " ", 
       SqrtBox["x"]}], 
      SqrtBox["\[Pi]"]], "]"}]}], "+", 
   RowBox[{
    RowBox[{"FresnelC", "[", 
     FractionBox[
      RowBox[{"2", " ", 
       SqrtBox["x"]}], 
      SqrtBox["\[Pi]"]], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "x"}], "]"}]}]}], 
  RowBox[{"2", " ", 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]], " ", 
   SuperscriptBox["x", 
    RowBox[{"3", "/", "2"}]]}]]], "Output",
 CellChangeTimes->{{3.863027307027988*^9, 3.863027313789154*^9}, 
   3.8630408653300447`*^9},
