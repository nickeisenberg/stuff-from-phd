Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Data", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", 
        FractionBox[
         RowBox[{
          SqrtBox[
           FractionBox["\[Pi]", "2"]], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Cos", "[", 
               RowBox[{"2", " ", "x"}], "]"}]}], " ", 
             RowBox[{"FresnelS", "[", 
              FractionBox[
               RowBox[{"2", " ", 
                SqrtBox[
                 RowBox[{"Abs", "[", "x", "]"}]]}], 
               SqrtBox["\[Pi]"]], "]"}]}], "+", 
            RowBox[{
             RowBox[{"FresnelC", "[", 
              FractionBox[
               RowBox[{"2", " ", 
                SqrtBox[
                 RowBox[{"Abs", "[", "x", "]"}]]}], 
               SqrtBox["\[Pi]"]], "]"}], " ", 
             RowBox[{"Sin", "[", 
              RowBox[{"2", 
               RowBox[{"Abs", "[", " ", "x", "]"}]}], "]"}]}]}], ")"}]}], 
         SuperscriptBox[
          RowBox[{"Abs", "[", "x", "]"}], 
          RowBox[{"3", "/", "2"}]]]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "8.001"}], ",", "8.001", ",", "0.1"}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<InverseFourier.csv\>\"", ",", 
   RowBox[{"PrependTo", "[", 
    RowBox[{"Data", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", "\"\<CSV\>\""}], 
  "]"}]}], "Input",
