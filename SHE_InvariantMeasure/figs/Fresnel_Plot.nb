Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     SqrtBox[
      RowBox[{"2", "-", "\[Xi]"}]], " ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{"x", " ", "\[Xi]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Xi]", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"x", ">", "0"}]}]}], "]"}], "//", "FullSimplify"}]], "Input",
