Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Pi]"}]], 
     SqrtBox[
      RowBox[{"2", "-", "\[Xi]"}]], " ", 
     RowBox[{"Cos", "[", " ", 
      RowBox[{"x", " ", "\[Xi]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Xi]", ",", "0", ",", "2"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"x", ">", "0"}]}]}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.863027211858738*^9, 3.86302722639716*^9}, {
  3.8630272880674047`*^9, 3.863027312979064*^9}, {3.863040861171677*^9, 
