Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"k", " ", 
        RowBox[{"Log", "[", "t", "]"}]}], " ", "-", " ", 
       RowBox[{"a", " ", "t"}]}], ",", "t"}], "]"}], "==", "0"}], ",", "t"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.86351324414427*^9, 3.863513267006287*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a9ad140d-bbae-4ffd-87a1-79820e4c2049"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"t", "\[Rule]", 
    FractionBox["k", "a"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.8635132590589046`*^9, 3.863513267270832*^9}},
 CellLabel->"Out[2]=",ExpressionUUID->"59b29ef3-ca7f-4614-b7fa-71f46cea0f5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"t", "^", "k"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "a"}], " ", "t"}], "]"}]}], "/.", 
   RowBox[{"t", "->", 
    FractionBox["k", "a"]}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.863513270719392*^9, 3.863513292396044*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"1a48e53c-9466-4d4d-a0a2-487480d063e6"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", "k"}]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox["k", "a"], ")"}], "k"]}]], "Output",
 CellChangeTimes->{3.863513292795542*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"205324b2-7077-457f-a764-d39105a8e053"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"s", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "a"}], " ", "s"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", "0", ",", "t"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"a", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.863513312524238*^9, 3.8635133287170362`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"48e0661d-3ea4-45a7-bb8c-1a2b1e4151b2"],

Cell[BoxData[
 FractionBox[
  RowBox[{"1", "-", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "a"}], " ", "t"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"a", " ", "t"}]}], ")"}]}]}], 
  SuperscriptBox["a", "2"]]], "Output",
