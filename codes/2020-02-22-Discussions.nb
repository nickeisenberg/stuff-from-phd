Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["t", "2"], "-", "x"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Erfc", "[", 
       FractionBox[
        RowBox[{"t", "-", "x"}], 
        RowBox[{
         SqrtBox["2"], " ", 
         SqrtBox["t"]}]], "]"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "x"}]], " ", 
       RowBox[{"Erfc", "[", 
        FractionBox[
         RowBox[{"t", "+", "x"}], 
         RowBox[{
          SqrtBox["2"], " ", 
          SqrtBox["t"]}]], "]"}]}]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "30"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "Full"}]}], "]"}]], "Input",
