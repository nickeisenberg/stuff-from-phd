Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["x", "2"]}], ")"}], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", "+", 
         SuperscriptBox["y", "2"]}]], 
       FractionBox["1", 
        SqrtBox[
         RowBox[{"2", "\[Pi]", " ", "t"}]]], 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "y"}], ")"}], "2"]}], 
         RowBox[{"2", "t"}]], "]"}]}], ",", 
      RowBox[{"{", 
