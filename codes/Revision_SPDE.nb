    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], 
       RowBox[{"2", " ", "t"}]]}]], " ", 
    SuperscriptBox["x", "2"]}], 
   RowBox[{"2", " ", 
    SqrtBox[
     RowBox[{"2", " ", "\[Pi]"}]], " ", 
    SuperscriptBox["t", 
     RowBox[{"5", "/", "2"}]]}]]}]], "Output",
 CellChangeTimes->{3.851603061681765*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"282afefd-b4e4-4255-a659-b025c4a68ca0"]
}, Open  ]],

