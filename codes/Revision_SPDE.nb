Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"t_", ",", "x_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    SqrtBox[
     RowBox[{"2", "\[Pi]", " ", "t"}]]], 
   RowBox[{"Exp", "[", 
    FractionBox[
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}], 
     RowBox[{"2", "t"}]], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.851603037498269*^9, 3.851603054550387*^9}},
