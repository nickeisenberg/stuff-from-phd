Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "n"}], " ", 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"a", " ", "n"}], "]"}], "/", 
      RowBox[{
       RowBox[{"f", "[", "n", "]"}], "^", "a"}]}], "]"}]}], ",", 
   RowBox[{"n", "->", "Infinity"}], ",", 
