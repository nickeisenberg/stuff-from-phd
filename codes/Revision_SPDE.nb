Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "n_", "]"}], ":=", 
  RowBox[{
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]", " ", "n"}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["n", "\[ExponentialE]"], ")"}], "n"]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.851597559308275*^9, 3.8515975913401203`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"0b4737a7-ad91-4c9a-b5e2-f165e0606059"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"f", "[", 
       FractionBox[
        RowBox[{"k", " ", "n"}], "2"], "]"}], "2"], 
     RowBox[{"f", "[", 
      RowBox[{"k", " ", "n"}], "]"}]], "//", "Expand"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", ">=", "100"}], ",", 
      RowBox[{"n", ">=", "200"}]}], "}"}]}]}], "]"}]], "Input",
